# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.
# Never commit real values.

# Resend (forms): API key, the address that receives inquiries, and a sender on a domain verified in Resend
RESEND_API_KEY=
CONTACT_TO=hello@behavitor.com
CONTACT_FROM=Behavitor <forms@behavitor.com>
# Optional: a Resend segment (audience) ID for newsletter sign-ups
RESEND_SEGMENT_ID=

# Analytics: create a GA4 Web Data Stream first. Leave blank to keep Google Analytics off.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Vercel Blob (private store): added automatically when you connect a Blob store to the project
BLOB_READ_WRITE_TOKEN=

# Editor at /admin: a long password, and a random secret for signing the login (e.g. `openssl rand -hex 32`)
ADMIN_PASSWORD=
SESSION_SECRET=

# Daily AI news refresh: Vercel sends this automatically to cron jobs once set
CRON_SECRET=
